{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block admin_content %}
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="m-0 text-primary"><i class="bi bi-tags"></i> Gestion des Catégories</h2>
        </div>
        <div class="col-auto">
            <a href="{{ path('admin_categorie_new') }}" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Nouvelle Catégorie
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for categorie in categories %}
                <tr>
                    <td>{{ categorie.id }}</td>
                    <td><strong>{{ categorie.nom }}</strong></td>
                    <td class="text-center">
                        <div class="btn-group">
                            <a href="{{ path('admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_categorie_delete', {'id': categorie.id}) }}" onsubmit="return confirm('Supprimer cette catégorie ?');" style="display:inline-block">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">Aucune catégorie trouvée</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        {{ knp_pagination_render(categories) }}
    </div>
{% endblock %}
