{% extends 'base.html.twig' %}
{% block title %}Commandes — Admin SymPet{% endblock %}
{% block body %}
<div class="container py-4">
<h4 class="fw-bold mb-4"><i class="bi bi-bag-check me-2"></i>Gestion des commandes</h4>
<div class="card mb-4">
    <div class="card-body py-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small fw-semibold me-2">Filtrer par statut :</span>
            <a href="{{ path('admin_commandes') }}"
               class="btn btn-sm rounded-pill {{ statut is null ? 'btn-dark' : 'btn-outline-secondary' }}">
                Tous
            </a>
            {% for s in statuts %}
                <a href="{{ path('admin_commandes', {statut: s}) }}"
                   class="btn btn-sm rounded-pill
                       {% if statut == s %}
                           {{ s == 'pending' ? 'btn-warning' : (s == 'processing' ? 'btn-primary' : 'btn-success') }}
                       {% else %}
                           btn-outline-secondary
                       {% endif %}">
                    {% if s == 'pending' %}En attente
                    {% elseif s == 'processing' %}En cours
                    {% else %}Terminée{% endif %}
                </a>
            {% endfor %}
            <span class="ms-auto text-muted small">{{ commandes|length }} commande(s)</span>
        </div>
    </div>
</div>

{# Tableau #}
<div class="card">
    <div class="card-header">
        <i class="bi bi-table me-2"></i>Liste des commandes
    </div>
    <div class="card-body p-0">
        {% if commandes is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Aucune commande trouvée.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Utilisateur</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td class="text-muted">#{{ commande.id }}</td>
                            <td>
                                {% if commande.utilisateur %}
                                    <span class="fw-semibold">{{ commande.utilisateur.email }}</span>
                                {% else %}
                                    <span class="text-muted fst-italic">Utilisateur supprimé</span>
                                {% endif %}
                            </td>
                            <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                            <td>
                                <span class="badge rounded-pill badge-{{ commande.statut }} px-3 py-2">
                                    {% if commande.statut == 'pending' %}
                                        <i class="bi bi-clock me-1"></i>En attente
                                    {% elseif commande.statut == 'processing' %}
                                        <i class="bi bi-arrow-repeat me-1"></i>En cours
                                    {% else %}
                                        <i class="bi bi-check-circle me-1"></i>Terminée
                                    {% endif %}
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin_commande_show', {id: commande.id}) }}"
                                   class="btn btn-sm btn-outline-success rounded-pill">
                                    <i class="bi bi-eye me-1"></i>Détail
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
</div>
{% endblock %}
