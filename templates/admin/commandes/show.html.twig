{% extends 'base.html.twig' %}
{% block title %}Commande #{{ commande.id }} — Admin SymPet{% endblock %}

{% block body %}
<div class="container py-4">
<h4 class="fw-bold mb-4"><i class="bi bi-bag-check me-2"></i>Détail commande #{{ commande.id }}</h4>

    {# Infos commande #}
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-receipt me-2"></i>Informations commande</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Numéro</dt>
                    <dd class="col-7 fw-bold">#{{ commande.id }}</dd>

                    <dt class="col-5 text-muted">Date</dt>
                    <dd class="col-7">{{ commande.dateCreation|date('d/m/Y') }}</dd>

                    <dt class="col-5 text-muted">Statut</dt>
                    <dd class="col-7">
                        <span class="badge rounded-pill badge-{{ commande.statut }} px-3 py-2">
                            {% if commande.statut == 'pending' %}
                                <i class="bi bi-clock me-1"></i>En attente
                            {% elseif commande.statut == 'processing' %}
                                <i class="bi bi-arrow-repeat me-1"></i>En cours
                            {% else %}
                                <i class="bi bi-check-circle me-1"></i>Terminée
                            {% endif %}
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    {# Infos utilisateur #}
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person me-2"></i>Client</div>
            <div class="card-body">
                {% if commande.utilisateur %}
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width:48px;height:48px;border-radius:50%;background:#e8f5ee;display:flex;align-items:center;justify-content:center;font-size:1.3rem;">
                            👤
                        </div>
                        <div>
                            <div class="fw-bold">{{ commande.utilisateur.email }}</div>
                            <span class="badge bg-{{ 'ROLE_ADMIN' in commande.utilisateur.roles ? 'danger' : 'secondary' }} rounded-pill">
                                {{ 'ROLE_ADMIN' in commande.utilisateur.roles ? 'Admin' : 'Utilisateur' }}
                            </span>
                        </div>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">ID</dt>
                        <dd class="col-7">#{{ commande.utilisateur.id }}</dd>
                    </dl>
                {% else %}
                    <div class="text-muted fst-italic">
                        <i class="bi bi-person-x me-2"></i>Utilisateur supprimé
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

</div>

<div class="mt-3">
    <a href="{{ path('admin_commandes') }}" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left me-1"></i>Retour aux commandes
    </a>
</div>
</div>
{% endblock %}
