{% extends 'base.html.twig' %}

{% block title %}Détail Commande #{{ commande.id }} - SymPet{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-4">
    <a href="{{ path('admin_order_index') }}" class="btn btn-link text-decoration-none p-0 me-3">
        <i class="fas fa-arrow-left fa-lg"></i>
    </a>
    <h1 class="mb-0">Commande #{{ commande.id }}</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Articles de la commande -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Articles</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Produit</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-end">Prix Unitaire</th>
                                <th class="text-end pe-4">Sous-total</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for ligne in commande.ligneCommandes %}
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="{{ (ligne.produit.imageUrl starts with 'http') ? ligne.produit.imageUrl : asset('uploads/produits/' ~ ligne.produit.imageUrl) }}" style="width: 40px; height: 40px; object-fit: cover;" class="rounded me-3">
                                        <div>
                                            <div class="fw-bold">{{ ligne.produit.nom }}</div>
                                            <small class="text-muted">{{ ligne.produit.categorie.nom }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">{{ ligne.quantite }}</td>
                                <td class="text-end">{{ ligne.prixUnitaire|number_format(3, ',', ' ') }} DT</td>
                                <td class="text-end pe-4 fw-bold">{{ (ligne.prixUnitaire * ligne.quantite)|number_format(3, ',', ' ') }} DT</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                        <tfoot class="table-light border-top-0">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3 ps-4">TOTAL</td>
                                <td class="text-end pe-4 fw-bold fs-5 text-primary py-3">{{ commande.total|number_format(3, ',', ' ') }} DT</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Infos Client -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Client</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-user text-primary"></i>
                    </div>
                    <div>
                        <div class="fw-bold">{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</div>
                        <div class="text-muted small">{{ commande.utilisateur.email }}</div>
                    </div>
                </div>
                <hr>
                <div class="mb-2">
                    <small class="text-muted d-block">Date de commande</small>
                    <span>{{ commande.dateCreation|date('d F Y à H:i') }}</span>
                </div>
            </div>
        </div>

        <!-- Modifier le statut -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Modifier le statut</h5>
            </div>
            <div class="card-body">
                <form action="{{ path('admin_order_change_status', {id: commande.id}) }}" method="post">
                    <div class="mb-3">
                        <select name="status" class="form-select">
                            <option value="En attente" {{ commande.statut == 'En attente' ? 'selected' : '' }}>En attente</option>
                            <option value="En cours" {{ commande.statut == 'En cours' ? 'selected' : '' }}>En cours</option>
                            <option value="Complétée" {{ commande.statut == 'Complétée' ? 'selected' : '' }}>Complétée</option>
                            <option value="Annulée" {{ commande.statut == 'Annulée' ? 'selected' : '' }}>Annulée</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Mettre à jour le statut</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
