{{ form_start(form) }}
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                {{ form_label(form.categorie) }}
                {{ form_widget(form.categorie) }}
                {{ form_errors(form.categorie) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.prix) }}
                {{ form_widget(form.prix) }}
                {{ form_errors(form.prix) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.stock) }}
                {{ form_widget(form.stock) }}
                {{ form_errors(form.stock) }}
            </div>

            <hr>

            <div class="form-check mb-2">
                {{ form_widget(form.isPromo) }}
                {{ form_label(form.isPromo) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.promotion) }}
                {{ form_widget(form.promotion) }}
                {{ form_errors(form.promotion) }}
            </div>

            <hr>

            <div class="form-check mb-3">
                {{ form_widget(form.isRupture) }}
                {{ form_label(form.isRupture) }}
            </div>
        </div>
    </div>
    
    <div class="mb-4">
        {{ form_label(form.imageFile) }}
        {{ form_widget(form.imageFile) }}
        {{ form_errors(form.imageFile) }}
    </div>
    
    <button class="btn btn-primary w-100 py-3 fw-bold">
        {{ button_label|default('Enregistrer le produit') }}
    </button>
{{ form_end(form) }}
