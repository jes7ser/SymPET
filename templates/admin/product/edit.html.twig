{% extends 'base.html.twig' %}

{% block title %}Modifier Produit - SymPet{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex align-items-center mb-4">
            <a href="{{ path('admin_product_index') }}" class="btn btn-link text-decoration-none p-0 me-3">
                <i class="fas fa-arrow-left fa-lg"></i>
            </a>
            <h1 class="mb-0">Modifier le produit</h1>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="mb-4 text-center">
                    <img src="{{ (produit.imageUrl starts with 'http') ? produit.imageUrl : asset('uploads/produits/' ~ produit.imageUrl) }}" alt="{{ produit.nom }}" style="max-width: 200px;" class="img-thumbnail">
                </div>
                {{ include('admin/product/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
