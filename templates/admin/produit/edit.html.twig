{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier Produit 🐾{% endblock %}

{% block admin_content %}
    <div class="mb-4">
        <a href="{{ path('admin_produit_index') }}" class="text-muted text-decoration-none">
            <i class="fas fa-arrow-left me-1"></i>Retour à la liste
        </a>
        <h1 class="fluffy-title mt-2">Modifier : {{ produit.nom }}</h1>
    </div>

    <div class="fluffy-card p-4 mx-auto" style="max-width: 800px;">
        {{ include('admin/produit/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
{% endblock %}
