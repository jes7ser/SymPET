{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Produits{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Produits</h2>
        <a href="{{ path('admin_produit_new') }}" class="btn btn-primary">
            <i class="bi bi-plus"></i> Nouveau Produit
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th>Prix</th>
                    <th>Stock</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for produit in produits %}
                <tr>
                    <td>
                        {% if produit.image %}
                            {% if 'http' in produit.image %}
                                <img src="{{ produit.image }}" class="img-thumbnail img-thumbnail-sm" alt="{{ produit.nom }}">
                            {% else %}
                                <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="img-thumbnail img-thumbnail-sm" alt="{{ produit.nom }}">
                            {% endif %}
                        {% else %}
                            <span class="text-muted small">Pas d'image</span>
                        {% endif %}
                    </td>
                    <td>
                        <strong>{{ produit.nom }}</strong>
                    </td>
                    <td>
                        <span class="badge bg-secondary text-white">{{ produit.categorie.nom|default('Aucune') }}</span>
                    </td>
                    <td>{{ produit.prix|number_format(3, ',', ' ') }} DT</td>
                    <td>
                        {% if produit.stock <= 0 %}
                            <span class="badge bg-danger">Rupture</span>
                        {% else %}
                            <span class="badge bg-success">{{ produit.stock }} en stock</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <div class="btn-group">
                            <a href="{{ path('admin_produit_edit', {'id': produit.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_produit_delete', {'id': produit.id}) }}" onsubmit="return confirm('Supprimer ce produit ?');" style="display:inline-block">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun produit trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        {{ knp_pagination_render(produits) }}
    </div>
{% endblock %}
