{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs - SymPet{% endblock %}

{% block body %}
<div class="mb-4">
    <h1>Gestion des Utilisateurs</h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nom & Prénom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="ps-4 text-muted">{{ user.id }}</td>
                        <td>
                            <div class="fw-bold">{{ user.prenom }} {{ user.nom }}</div>
                        </td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger">Administrateur</span>
                            {% else %}
                                <span class="badge bg-info text-dark">Client</span>
                            {% endif %}
                        </td>
                        <td>
                            <form action="{{ path('admin_user_toggle_status', {id: user.id}) }}" method="post">
                                <button type="submit" class="btn btn-sm {{ user.isEnabled ? 'btn-success' : 'btn-secondary' }}">
                                    {{ user.isEnabled ? 'Activé' : 'Désactivé' }}
                                </button>
                            </form>
                        </td>
                        <td class="text-end pe-4">
                            {% if user != app.user %}
                            <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
