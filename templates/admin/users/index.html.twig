{% extends 'base.html.twig' %}
{% block title %}Utilisateurs — Admin SymPet{% endblock %}

{% block body %}
<div class="container py-4">
<h4 class="fw-bold mb-4"><i class="bi bi-people me-2"></i>Gestion des utilisateurs</h4>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Liste des utilisateurs</span>
        <span class="text-muted small">{{ users|length }} utilisateur(s)</span>
    </div>
    <div class="card-body p-0">
        {% if users is empty %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                Aucun utilisateur trouvé.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                        <tr>
                            <td class="text-muted">#{{ user.id }}</td>
                            <td class="fw-semibold">{{ user.email }}</td>
                            <td>
                                {% set isAdmin = 'ROLE_ADMIN' in user.roles %}
                                <span class="badge rounded-pill px-3 py-2 {{ isAdmin ? 'bg-danger' : 'bg-secondary' }}">
                                    {{ isAdmin ? 'Admin' : 'Utilisateur' }}
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin_user_edit', {id: user.id}) }}"
                                   class="btn btn-sm btn-outline-secondary rounded-pill me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Supprimer cet utilisateur ?')">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
</div>
{% endblock %}
