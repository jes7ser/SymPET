{% extends 'base.html.twig' %}

{% block title %}Accueil — SymPet{% endblock %}

{% block stylesheets %}
    .hero {
        background: linear-gradient(135deg, #e8f5ee 0%, #f7f3ee 100%);
        padding: 5rem 0 4rem;
        text-align: center;
    }

    .hero h1 { font-size: 2.6rem; font-weight: 800; color: #2d3748; }
    .hero h1 span { color: #4caf82; }
    .hero p { font-size: 1.1rem; color: #718096; }

    .animal-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,.07);
        transition: transform .2s, box-shadow .2s;
        cursor: default;
    }

    .animal-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 8px 24px rgba(76,175,130,.2);
    }
{% endblock %}

{% block body %}

<section class="hero">
    <div class="container">
        <div style="font-size: 4.5rem; animation: bounce 2s infinite;">🐾</div>
        <h1 class="mt-3">Bienvenue sur <span>SymPet</span></h1>
        <p class="mt-2 mb-4">Votre boutique en ligne dédiée au bien-être de vos animaux de compagnie.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="{{ path('app_login') }}" class="btn btn-success btn-lg rounded-pill px-5">
                <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
            </a>
            <a href="{{ path('app_register') }}" class="btn btn-outline-success btn-lg rounded-pill px-5">
                <i class="bi bi-person-plus me-2"></i>S'inscrire
            </a>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4" style="color:#2d3748">Nos catégories</h2>
        <div class="row g-4 justify-content-center">
            {% for item in [
                {icon: '🐶', label: 'Chiens',   desc: 'Croquettes, jouets, accessoires'},
                {icon: '🐱', label: 'Chats',    desc: 'Litières, griffoirs, friandises'},
                {icon: '🐠', label: 'Poissons', desc: 'Aquariums, nourriture, déco'},
                {icon: '🐹', label: 'Rongeurs', desc: 'Cages, roues, granulés'}
            ] %}
            <div class="col-6 col-md-3">
                <div class="card animal-card p-4 text-center h-100">
                    <div style="font-size: 2.8rem">{{ item.icon }}</div>
                    <h5 class="fw-bold mt-2 mb-1">{{ item.label }}</h5>
                    <p class="text-muted small mb-0">{{ item.desc }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
<style>
    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>
{% endblock %}
