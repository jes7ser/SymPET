{# templates/knp_paginator/sliding.html.twig #}
{% if pageCount > 1 %}
<nav class="sympet-pagination" aria-label="Pagination">

    {# Bouton Précédent #}
    {% if current > 1 %}
        <a href="{{ path(route, query|merge({(pageParameterName): current - 1})) }}"
           class="pag-btn" aria-label="Page précédente">
            <i class="bi bi-chevron-left"></i>
        </a>
    {% else %}
        <span class="pag-btn pag-btn--disabled" aria-disabled="true">
            <i class="bi bi-chevron-left"></i>
        </span>
    {% endif %}

    {# Compteur central : page actuelle / total #}
    <span class="pag-counter">{{ current }}&nbsp;/&nbsp;{{ pageCount }}</span>

    {# Bouton Suivant #}
    {% if current < pageCount %}
        <a href="{{ path(route, query|merge({(pageParameterName): current + 1})) }}"
           class="pag-btn" aria-label="Page suivante">
            <i class="bi bi-chevron-right"></i>
        </a>
    {% else %}
        <span class="pag-btn pag-btn--disabled" aria-disabled="true">
            <i class="bi bi-chevron-right"></i>
        </span>
    {% endif %}

</nav>
{% endif %}
