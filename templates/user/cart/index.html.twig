{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-cart3"></i> Mon Panier</h2>
        <a href="{{ path('app_user_vitrine') }}" class="btn btn-outline-secondary">Continuer mes achats</a>
    </div>

    {% if items|length > 0 %}
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Produit</th>
                                    <th scope="col" class="text-center">Prix unitaire</th>
                                    <th scope="col" class="text-center">Quantité</th>
                                    <th scope="col" class="text-center">Total</th>
                                    <th scope="col" class="text-center pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                {% if item.produit.imageUrl %}
                                                    {% if 'http' in item.produit.imageUrl %}
                                                        <img src="{{ item.produit.imageUrl }}" class="rounded me-3" alt="{{ item.produit.nom }}" style="width: 60px; height: 60px; object-fit: cover;">
                                                    {% else %}
                                                        <img src="{{ asset('uploads/produits/' ~ item.produit.imageUrl) }}" class="rounded me-3" alt="{{ item.produit.nom }}" style="width: 60px; height: 60px; object-fit: cover;">
                                                    {% endif %}
                                                {% else %}
                                                    <div class="bg-light rounded d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px;">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                {% endif %}
                                                
                                                <div>
                                                    <h6 class="mb-0 fw-bold">{{ item.produit.nom }}</h6>
                                                    <small class="text-muted">{{ item.produit.categorie.nom|default('') }}</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold">{{ item.produit.prix|number_format(3, ',', ' ') }} DT</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex align-items-center bg-light border rounded">
                                                {% if item.quantite > 1 %}
                                                    <a href="{{ path('app_cart_decrement', {'id': item.produit.id}) }}" class="btn btn-sm btn-light border-0 text-dark" style="width: 30px;"><i class="bi bi-dash"></i></a>
                                                {% else %}
                                                    <span style="width: 30px; display: inline-block;"></span>
                                                {% endif %}
                                                <span class="px-3 fw-bold">{{ item.quantite }}</span>
                                                <a href="{{ path('app_cart_add', {'id': item.produit.id}) }}" class="btn btn-sm btn-light border-0 text-dark" style="width: 30px;"><i class="bi bi-plus"></i></a>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold text-success">{{ (item.produit.prix * item.quantite)|number_format(3, ',', ' ') }} DT</td>
                                        <td class="text-center pe-4">
                                            <a href="{{ path('app_cart_remove', {'id': item.produit.id}) }}" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Récapitulatif</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sous-total</span>
                            <span class="fw-semibold">{{ total|number_format(3, ',', ' ') }} DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Livraison</span>
                            <span class="text-success fw-semibold">Gratuite</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold mb-0">Total</span>
                            <span class="h5 fw-bold text-success mb-0">{{ total|number_format(3, ',', ' ') }} DT</span>
                        </div>
                        {% if is_granted('ROLE_USER') %}
                            <a href="{{ path('app_user_commande_new') }}" class="btn btn-success btn-lg w-100 fw-bold">Valider et commander</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-warning btn-lg w-100 fw-bold">Connectez-vous pour commander</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h3 class="mt-3">Votre panier est vide</h3>
            <p class="text-muted mb-4">Parcourez notre boutique pour trouver des produits pour votre animal.</p>
            <a href="{{ path('app_user_vitrine') }}" class="btn btn-success btn-lg">Découvrir nos produits</a>
        </div>
    {% endif %}
</div>
{% endblock %}
