{% extends 'base.html.twig' %}

{% block title %}Mes commandes — SymPET{% endblock %}

{% block body %}
<div style="background-color: #f4f6f9; min-height: 100vh; padding: 40px 0;">
<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #1a2e4a;">
            <i class="bi bi-clock-history me-2"></i>Mes commandes
        </h2>
        <a href="{{ path('app_user_vitrine') }}" class="btn btn-outline-success">
            <i class="bi bi-shop me-1"></i>Continuer mes achats
        </a>
    </div>

    {% if commandes|length > 0 %}
        <div class="card border-0" style="border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08);">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">N° Commande</th>
                                <th>Date</th>
                                <th class="text-center">Nb articles</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Mode paiement</th>
                                <th class="text-center">Statut</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in commandes %}
                            <tr>
                                <td class="ps-4 fw-bold">#{{ commande.id }}</td>
                                <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                                <td class="text-center">
                                    {% set nbArticles = 0 %}
                                    {% for ligne in commande.ligneCommandes %}
                                        {% set nbArticles = nbArticles + ligne.quantite %}
                                    {% endfor %}
                                    {{ nbArticles }}
                                </td>
                                <td class="text-center fw-bold text-danger">
                                    {{ commande.total|number_format(3, ',', ' ') }} DT
                                </td>
                                <td class="text-center">
                                    {% if commande.modePaiement == 'stripe' %}
                                        <span class="badge bg-primary">
                                            <i class="bi bi-credit-card me-1"></i>Carte
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-truck me-1"></i>Livraison
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {# Badge coloré selon le statut #}
                                    {% if commande.statut == 'livree' %}
                                        <span class="badge bg-success px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>Livrée
                                        </span>
                                    {% elseif commande.statut == 'en_attente' %}
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="bi bi-hourglass-split me-1"></i>En attente
                                        </span>
                                    {% elseif commande.statut == 'annulee' %}
                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="bi bi-x-circle me-1"></i>Annulée
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary px-3 py-2">{{ commande.statut }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-4">
                                    <a href="{{ path('app_user_commande_show', {'id': commande.id}) }}"
                                       class="btn btn-sm btn-outline-dark" style="border-radius: 8px;">
                                        <i class="bi bi-eye me-1"></i>Voir détail
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card border-0 text-center py-5" style="border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08);">
            <div class="card-body">
                <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 fw-bold">Aucune commande pour l'instant</h4>
                <p class="text-muted mb-4">Vous n'avez pas encore passé de commande.</p>
                <a href="{{ path('app_user_vitrine') }}" class="btn btn-success btn-lg px-5" style="border-radius: 10px;">
                    Découvrir nos produits
                </a>
            </div>
        </div>
    {% endif %}

</div>
</div>
{% endblock %}
