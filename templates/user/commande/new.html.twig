{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande — SymPET{% endblock %}

{% block body %}
<div style="background-color: #f4f6f9; min-height: 100vh; padding: 40px 0;">
<div class="container">

    <h2 class="fw-bold mb-4" style="color: #1a2e4a;">
        <i class="bi bi-bag-check me-2"></i>Finaliser ma commande
    </h2>

    <form action="{{ path('app_user_commande_checkout') }}" method="POST" id="commandeForm" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('commande') }}">

        <div class="row g-4">

            {# ── Colonne gauche : formulaire ── #}
            <div class="col-lg-7">

                {# Section 1 : Adresse de livraison #}
                <div class="card border-0 mb-4" style="border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4" style="color: #1a2e4a;">
                            <i class="bi bi-geo-alt me-2 text-success"></i>1. Adresse de livraison
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nom</label>
                                <input type="text" name="nom" class="form-control" style="border-radius: 8px;"
                                       value="{{ user.nom }}" required
                                       pattern="[a-zA-ZÀ-ÿ\s\-']+" minlength="2" maxlength="100"
                                       title="Lettres uniquement (min 2 caractères)">
                                <div class="invalid-feedback">Nom invalide (lettres uniquement, min 2 caractères).</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Prénom</label>
                                <input type="text" name="prenom" class="form-control" style="border-radius: 8px;"
                                       value="{{ user.prenom }}" required
                                       pattern="[a-zA-ZÀ-ÿ\s\-']+" minlength="2" maxlength="100"
                                       title="Lettres uniquement (min 2 caractères)">
                                <div class="invalid-feedback">Prénom invalide (lettres uniquement, min 2 caractères).</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="email" class="form-control" style="border-radius: 8px;"
                                       value="{{ user.email }}" required>
                                <div class="invalid-feedback">Adresse email invalide.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Numéro de téléphone</label>
                                <input type="tel" name="telephone" id="telephone" class="form-control" style="border-radius: 8px;"
                                       placeholder="Ex: 55 123 456" required
                                       pattern="[0-9]{8}" maxlength="8"
                                       title="8 chiffres exactement (ex: 55123456)"
                                       oninput="this.value = this.value.replace(/\D/g, '').substring(0, 8)">
                                <div class="form-text text-muted">8 chiffres, sans espaces.</div>
                                <div class="invalid-feedback">Téléphone invalide (8 chiffres requis).</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Code postal</label>
                                <input type="text" name="codePostal" id="codePostal" class="form-control" style="border-radius: 8px;"
                                       placeholder="Ex: 1000" required
                                       pattern="[0-9]{4}" maxlength="4"
                                       title="4 chiffres exactement (ex: 1000)"
                                       oninput="this.value = this.value.replace(/\D/g, '').substring(0, 4)">
                                <div class="form-text text-muted">4 chiffres.</div>
                                <div class="invalid-feedback">Code postal invalide (4 chiffres requis).</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Nom de rue et numéro de maison</label>
                                <input type="text" name="adresse" class="form-control" style="border-radius: 8px;"
                                       placeholder="Ex: 12 Rue de la République" required
                                       minlength="5" maxlength="255"
                                       title="Adresse complète (min 5 caractères)">
                                <div class="invalid-feedback">Adresse invalide (min 5 caractères).</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Gouvernorat</label>
                                <select name="gouvernorat" class="form-select" style="border-radius: 8px;" required>
                                    <option value="">-- Choisir un gouvernorat --</option>
                                    {% for gov in ['Tunis','Ariana','Ben Arous','Manouba','Nabeul','Zaghouan',
                                        'Bizerte','Béja','Jendouba','Kef','Siliana','Sousse','Monastir',
                                        'Mahdia','Sfax','Kairouan','Kasserine','Sidi Bouzid','Gabès',
                                        'Médenine','Tataouine','Gafsa','Tozeur','Kébili'] %}
                                        <option value="{{ gov }}">{{ gov }}</option>
                                    {% endfor %}
                                </select>
                                <div class="invalid-feedback">Veuillez choisir un gouvernorat.</div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Section 2 : Mode de paiement #}
                <div class="card border-0" style="border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4" style="color: #1a2e4a;">
                            <i class="bi bi-credit-card me-2 text-success"></i>2. Mode de paiement
                        </h5>

                        {# Option : Paiement à la livraison #}
                        <div class="form-check p-3 mb-3 border rounded" style="border-radius: 8px !important; cursor: pointer;"
                             onclick="selectPaiement('livraison')">
                            <input class="form-check-input" type="radio" name="modePaiement"
                                   id="paiementLivraison" value="livraison" checked
                                   onchange="toggleStripe(false)">
                            <label class="form-check-label fw-semibold ms-2" for="paiementLivraison" style="cursor: pointer;">
                                <i class="bi bi-truck me-2 text-success"></i>Paiement à la livraison
                            </label>
                            <p class="text-muted small mb-0 ms-4">Payez en espèces à la réception de votre colis.</p>
                        </div>

                        {# Option : Paiement par carte Stripe #}
                        <div class="form-check p-3 border rounded" style="border-radius: 8px !important; cursor: pointer;"
                             onclick="selectPaiement('stripe')">
                            <input class="form-check-input" type="radio" name="modePaiement"
                                   id="paiementStripe" value="stripe"
                                   onchange="toggleStripe(true)">
                            <label class="form-check-label fw-semibold ms-2" for="paiementStripe" style="cursor: pointer;">
                                <i class="bi bi-credit-card-2-front me-2 text-primary"></i>Paiement par carte (Stripe)
                            </label>
                            <p class="text-muted small mb-0 ms-4">Paiement sécurisé par carte bancaire.</p>
                        </div>

                        {# Champs carte Stripe (cachés par défaut) #}
                        <div id="stripeFields" class="mt-3 p-3 bg-light rounded" style="display:none; border-radius: 8px !important;">
                            <p class="text-muted small mb-3">
                                <i class="bi bi-shield-lock me-1 text-success"></i>
                                Vos données sont chiffrées et sécurisées par Stripe.
                                Vous serez redirigé vers la page de paiement Stripe.
                            </p>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Numéro de carte</label>
                                    <input type="text" class="form-control" style="border-radius: 8px;"
                                           placeholder="1234 5678 9012 3456" maxlength="19"
                                           oninput="formatCard(this)">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Date d'expiration</label>
                                    <input type="text" class="form-control" style="border-radius: 8px;"
                                           placeholder="MM/AA" maxlength="5">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">CVV</label>
                                    <input type="text" class="form-control" style="border-radius: 8px;"
                                           placeholder="123" maxlength="3">
                                </div>
                            </div>
                            <div class="alert alert-info mt-3 mb-0 small">
                                <i class="bi bi-info-circle me-1"></i>
                                En cliquant sur "Valider la commande", vous serez redirigé vers la page de paiement sécurisée Stripe.
                            </div>
                        </div>

                    </div>
                </div>

            </div>{# fin colonne gauche #}

            {# ── Colonne droite : récapitulatif ── #}
            <div class="col-lg-5">
                <div class="card border-0 sticky-top" style="border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); top: 20px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4" style="color: #1a2e4a;">
                            <i class="bi bi-receipt me-2 text-success"></i>Récapitulatif
                        </h5>

                        {# Liste des articles #}
                        {% set totalArticles = 0 %}
                        {% for item in items %}
                            {% set totalArticles = totalArticles + item.quantite %}
                            <div class="d-flex align-items-center mb-3">
                                {% if item.produit.imageUrl starts with 'http' %}
                                    <img src="{{ item.produit.imageUrl }}" alt="{{ item.produit.nom }}"
                                         style="width:50px;height:50px;object-fit:cover;border-radius:8px;" class="me-3">
                                {% else %}
                                    <img src="{{ asset('uploads/produits/' ~ item.produit.imageUrl) }}" alt="{{ item.produit.nom }}"
                                         style="width:50px;height:50px;object-fit:cover;border-radius:8px;" class="me-3">
                                {% endif %}
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">{{ item.produit.nom }}</div>
                                    <div class="text-muted small">Qté : {{ item.quantite }}</div>
                                </div>
                                <div class="fw-bold small">{{ (item.produit.prix * item.quantite)|number_format(3, ',', ' ') }} DT</div>
                            </div>
                        {% endfor %}

                        <hr>

                        {# Totaux #}
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Nombre d'articles</span>
                            <span class="fw-semibold">{{ totalArticles }}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sous-total</span>
                            <span class="fw-semibold">{{ total|number_format(3, ',', ' ') }} DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Livraison</span>
                            <span class="text-success fw-semibold">Gratuite</span>
                        </div>

                        {# Code promo #}
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Code promo"
                                   style="border-radius: 8px 0 0 8px;">
                            <button class="btn btn-warning fw-semibold" type="button"
                                    style="border-radius: 0 8px 8px 0;">Appliquer</button>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold mb-0">Total</span>
                            <span class="h5 fw-bold mb-0 text-danger">{{ total|number_format(3, ',', ' ') }} DT</span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100 fw-bold" style="border-radius: 10px;">
                            <i class="bi bi-lock me-2"></i>Valider la commande
                        </button>

                        <p class="text-center text-muted small mt-3 mb-0">
                            <i class="bi bi-shield-check me-1 text-success"></i>Paiement 100% sécurisé
                        </p>
                    </div>
                </div>
            </div>{# fin colonne droite #}

        </div>{# fin row #}
    </form>

</div>
</div>

<script>
    // Validation Bootstrap : affiche les erreurs au submit
    document.getElementById('commandeForm').addEventListener('submit', function(e) {
        if (!this.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
        }
        this.classList.add('was-validated');
    });

    // Affiche ou cache les champs Stripe selon le mode de paiement sélectionné
    function toggleStripe(show) {
        document.getElementById('stripeFields').style.display = show ? 'block' : 'none';
    }

    // Sélectionne le radio button et met à jour l'affichage
    function selectPaiement(mode) {
        document.getElementById('paiement' + (mode === 'stripe' ? 'Stripe' : 'Livraison')).checked = true;
        toggleStripe(mode === 'stripe');
    }

    // Formate le numéro de carte avec des espaces tous les 4 chiffres
    function formatCard(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 16);
        input.value = val.replace(/(.{4})/g, '$1 ').trim();
    }
</script>
{% endblock %}
