{% extends 'base.html.twig' %}
{% block title %}Valider la commande — SymPet{% endblock %}

{% block body %}
<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-check-circle me-2 text-success"></i>Valider la commande</h2>

    <div class="row g-4">

        {# Récapitulatif panier #}
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header fw-bold">
                    <i class="bi bi-cart3 me-2"></i>Récapitulatif
                </div>
                <div class="card-body p-0">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">Sous-total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                            <tr>
                                <td>
                                    <div class="fw-semibold">{{ item.produit.nom }}</div>
                                    <div class="text-muted small">{{ item.produit.prix|number_format(2, ',', ' ') }} DT</div>
                                </td>
                                <td class="text-center">{{ item.quantite }}</td>
                                <td class="text-end fw-bold text-success">
                                    {{ item.sousTotal|number_format(2, ',', ' ') }} DT
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="table-success">
                                <td colspan="2" class="fw-bold">Total</td>
                                <td class="text-end fw-bold fs-5">{{ total|number_format(2, ',', ' ') }} DT</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        {# Formulaire utilisateur #}
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header fw-bold">
                    <i class="bi bi-person me-2"></i>Client
                </div>
                <div class="card-body p-4">
                    <form method="post" action="{{ path('commande_valider') }}">

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Sélectionner le client</label>
                            <select name="utilisateur_id" class="form-select" required>
                                <option value="">-- Choisir un client --</option>
                                {% for user in users %}
                                    <option value="{{ user.id }}">
                                        #{{ user.id }} — {{ user.email }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">
                            <i class="bi bi-check-circle me-2"></i>Confirmer la commande
                        </button>

                        <a href="{{ path('panier_index') }}" class="btn btn-outline-secondary w-100 rounded-pill mt-2">
                            <i class="bi bi-arrow-left me-1"></i>Retour au panier
                        </a>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
