{% extends 'base.html.twig' %}
{% block title %}Mon panier — SymPet{% endblock %}

{% block body %}
<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 me-2 text-success"></i>Mon panier</h2>

    {% if items is empty %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cart-x fs-1 d-block mb-3"></i>
            <p class="fs-5">Votre panier est vide.</p>
            <a href="{{ path('produit_index') }}" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-grid me-2"></i>Voir les produits
            </a>
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-success">
                                <tr>
                                    <th>Produit</th>
                                    <th class="text-center">Quantité</th>
                                    <th class="text-end">Sous-total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="{{ item.produit.image }}" alt="{{ item.produit.nom }}"
                                                 style="width:55px;height:55px;object-fit:cover;border-radius:10px;">
                                            <div>
                                                <div class="fw-semibold">{{ item.produit.nom }}</div>
                                                <div class="text-muted small">{{ item.produit.prix|number_format(2, ',', ' ') }} DT / unité</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center" style="width:160px">
                                        <form method="post" action="{{ path('panier_modifier', {id: item.produit.id}) }}"
                                              class="d-flex align-items-center justify-content-center gap-2">
                                            <input type="number" name="quantite" value="{{ item.quantite }}"
                                                   min="1" class="form-control form-control-sm text-center"
                                                   style="width:65px">
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill">
                                                <i class="bi bi-check"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        {{ item.sousTotal|number_format(2, ',', ' ') }} DT
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('panier_supprimer', {id: item.produit.id}) }}"
                                           class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="{{ path('panier_vider') }}" class="btn btn-outline-danger rounded-pill btn-sm"
                       onclick="return confirm('Vider le panier ?')">
                        <i class="bi bi-trash me-1"></i>Vider le panier
                    </a>
                    <a href="{{ path('produit_index') }}" class="btn btn-outline-secondary rounded-pill btn-sm ms-2">
                        <i class="bi bi-arrow-left me-1"></i>Continuer mes achats
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-success text-white rounded-top-4 fw-bold">
                        <i class="bi bi-receipt me-2"></i>Récapitulatif
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sous-total</span>
                            <span>{{ total|number_format(2, ',', ' ') }} DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Livraison</span>
                            <span class="text-success">Gratuite</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span class="text-success">{{ total|number_format(2, ',', ' ') }} DT</span>
                        </div>
                        <a href="{{ path('commande_valider') }}" class="btn btn-success w-100 rounded-pill fw-bold">
                            <i class="bi bi-check-circle me-2"></i>Valider la commande
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
