{% extends 'base.html.twig' %}
{% block title %}Produits — SymPet{% endblock %}

{% block body %}
<div class="container py-4">
    <h2 class="fw-bold mb-4">🐾 Nos produits</h2>

    <div class="row g-4">
        {% for produit in produits %}
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card produit-card h-100">
                <img src="{{ produit.image }}" alt="{{ produit.nom }}">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-success-subtle text-success rounded-pill mb-2" style="width:fit-content">
                        {{ produit.categorie.nom }}
                    </span>
                    <h6 class="fw-bold mb-1">{{ produit.nom }}</h6>
                    <p class="text-muted small flex-grow-1">{{ produit.description|slice(0, 60) }}...</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="prix">{{ produit.prix|number_format(2, ',', ' ') }} DT</span>
                        {% if produit.stock > 0 %}
                            <a href="{{ path('panier_ajouter', {id: produit.id}) }}"
                               class="btn btn-success btn-sm rounded-pill">
                                <i class="bi bi-cart-plus"></i>
                            </a>
                        {% else %}
                            <span class="badge bg-danger rounded-pill">Rupture</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% else %}
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>Aucun produit disponible.
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
