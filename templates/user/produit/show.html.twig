{% extends 'base.html.twig' %}
{% block title %}{{ produit.nom }} — SymPet{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row g-4 align-items-start">
        <div class="col-md-5">
            <img src="{{ produit.image }}" alt="{{ produit.nom }}"
                 class="img-fluid rounded-4 shadow-sm w-100" style="max-height:350px;object-fit:cover;">
        </div>
        <div class="col-md-7">
            <span class="badge bg-success-subtle text-success rounded-pill mb-2">{{ produit.categorie.nom }}</span>
            <h2 class="fw-bold">{{ produit.nom }}</h2>
            <p class="text-muted">{{ produit.description }}</p>
            <div class="fs-3 fw-bold text-success mb-3">{{ produit.prix|number_format(2, ',', ' ') }} DT</div>

            {% if produit.stock > 0 %}
                <p class="text-success small"><i class="bi bi-check-circle me-1"></i>{{ produit.stock }} en stock</p>
                <a href="{{ path('panier_ajouter', {id: produit.id}) }}" class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                </a>
            {% else %}
                <span class="badge bg-danger rounded-pill px-3 py-2">Rupture de stock</span>
            {% endif %}

            <div class="mt-3">
                <a href="{{ path('produit_index') }}" class="btn btn-outline-secondary rounded-pill btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
