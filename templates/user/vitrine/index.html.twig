{% extends 'base.html.twig' %}

{% block title %}Boutique SymPET{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Notre Boutique</h1>

    <!-- Formulaire de recherche -->
    <div class="card p-3 mb-4 bg-light">
        <form action="{{ path('app_user_vitrine') }}" method="get" class="row g-3">
            <div class="col-md-5">
                <input type="text" name="nom" class="form-control" placeholder="Rechercher un produit par nom..." value="{{ nom }}">
            </div>
            <div class="col-md-5">
                <select name="categorie" class="form-select">
                    <option value="">Toutes les catégories</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {% if categorieChoisie == cat.id %}selected{% endif %}>
                            {{ cat.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Chercher
                </button>
            </div>
        </form>
    </div>

    <!-- Liste des produits -->
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        {% for produit in produits %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <!-- Image -->
                    {% if produit.image %}
                        {% if 'http' in produit.image %}
                            <img src="{{ produit.image }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 200px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 200px; object-fit: cover;">
                        {% endif %}
                    {% else %}
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span>Pas d'image</span>
                        </div>
                    {% endif %}
                    
                    <div class="card-body d-flex flex-column">
                        <!-- Nom -->
                        <h5 class="card-title">{{ produit.nom }}</h5>
                        
                        <!-- Prix -->
                        <h4 class="text-primary mb-3">{{ produit.prix|number_format(3, ',', ' ') }} DT</h4>
                        
                        <!-- Boutons -->
                        <div class="mt-auto d-grid gap-2">
                            <a href="{{ path('app_user_vitrine_show', {'id': produit.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-eye"></i> Voir détail
                            </a>
                            <a href="#" class="btn btn-success">
                                <i class="bi bi-cart-plus"></i> Ajouter au panier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <h3 class="text-muted">Aucun produit ne correspond à votre recherche.</h3>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination ajoutée ici -->
    <div class="mt-4 d-flex justify-content-center">
        {{ knp_pagination_render(produits) }}
    </div>
</div>
{% endblock %}
