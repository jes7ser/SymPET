{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <!-- Image du produit -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                {% if produit.image %}
                    {% if 'http' in produit.image %}
                        <img src="{{ produit.image }}" class="card-img-top rounded" alt="{{ produit.nom }}">
                    {% else %}
                        <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="card-img-top rounded" alt="{{ produit.nom }}">
                    {% endif %}
                {% else %}
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                        <span>Pas d'image disponible</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Détails du produit -->
        <div class="col-md-7 mt-4 mt-md-0">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_user_vitrine') }}">Boutique</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ produit.nom }}</li>
                </ol>
            </nav>

            <h1 class="display-5 fw-bold">{{ produit.nom }}</h1>
            <p class="text-muted">
                Catégorie : <span class="badge bg-secondary">{{ produit.categorie.nom|default('Aucune') }}</span>
            </p>

            <h2 class="text-primary mb-4">{{ produit.prix|number_format(3, ',', ' ') }} DT</h2>

            <div class="mb-4">
                <h5>Description</h5>
                <p class="lead" style="font-size: 1.1rem;">
                    {{ produit.description|default('Aucune description pour ce produit.') }}
                </p>
            </div>

            <div class="mb-4">
                {% if produit.stock > 0 %}
                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> En stock ({{ produit.stock }} disponibles)</span>
                {% else %}
                    <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Rupture de stock</span>
                {% endif %}
            </div>

            <!-- Action: Ajouter au panier -->
            <form action="#" method="POST" class="d-flex gap-3 align-items-center mt-4">
                {% if produit.stock > 0 %}
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-cart-plus"></i> Ajouter au panier
                    </button>
                {% else %}
                    <button type="button" class="btn btn-secondary btn-lg" disabled>
                        <i class="bi bi-cart-x"></i> Indisponible
                    </button>
                {% endif %}
                <a href="{{ path('app_user_vitrine') }}" class="btn btn-outline-secondary btn-lg">Retour</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}
